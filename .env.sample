# Application Core
NODE_ENV="development" # The environment the application is running in (e.g., development, production)
PORT="3000" # The port on which the development server will run

# API Configuration
REACT_APP_API_BASE_URL="your_api_base_url_here" # The base URL for your backend API
REACT_APP_API_KEY="your_api_key_here" # API key for authenticating requests to your backend

# Clock Application Features
REACT_APP_DEFAULT_TIMEZONE="your_default_timezone_here" # e.g., America/New_York - The default timezone for the application
REACT_APP_WORLD_CLOCK_API_URL="your_world_clock_api_url_here" # Optional: URL for an external world clock or time zone API
REACT_APP_WORLD_CLOCK_API_KEY="your_world_clock_api_key_here" # Optional: API key for the world clock service

# Logging and Debugging
REACT_APP_LOG_LEVEL="info" # The minimum level of logs to display (e.g., debug, info, warn, error)
